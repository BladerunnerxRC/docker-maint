#!/usr/bin/env bash
# dm-images — image inventory and registry update check for images in use.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
  cat <<EOF
${BOLD}dm-images${RESET} — image inventory & update checker

${BOLD}Usage:${RESET} dm-images [options]

${BOLD}Options:${RESET}
  -u, --updates      Check the registry for newer digests of images used by containers
  -a, --all          With --updates, check every tagged image (not just ones in use)
  -h, --help         Show this help

Update checks compare the local RepoDigest with the registry's current digest for the same
tag (no image is pulled). Requires network access; private registries need 'docker login'.
EOF
}

UPDATES=0 ALL=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--updates) UPDATES=1 ;;
    -a|--all)     ALL=1 ;;
    -h|--help)    usage; exit 0 ;;
    *) die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

need_docker; need jq

# image ID → names of containers using it
usage_map=$(docker ps -aq | xargs -r docker inspect | jq -c 'group_by(.Image) | map({key: .[0].Image, value: map(.Name | ltrimstr("/"))}) | from_entries')
[[ -n "$usage_map" ]] || usage_map='{}'
images=$(docker images -q --no-trunc | sort -u | xargs -r docker image inspect)
[[ -n "$images" ]] || images='[]'

banner "Docker Images" "$(jq length <<<"$images") image(s) · $(date '+%Y-%m-%d %H:%M')"

section "Inventory"
{
  printf 'REPOSITORY:TAG\tID\tSIZE\tAGE\tARCH\tUSED BY\n'
  jq -r --argjson u "$usage_map" '
    sort_by(-(.Created | sub("\\.[0-9]+"; "") | fromdateiso8601? // 0))[] |
    [((.RepoTags // [])[0] // "<none>"), (.Id | ltrimstr("sha256:") | .[0:12]), (.Size | tostring), .Created, .Architecture,
     ($u[.Id] // [] | join(","))] | @tsv' <<<"$images" |
  while IFS=$'\t' read -r tag id size created arch used; do
    tc="$tag"; [[ "$tag" == "<none>" ]] && tc="${GREY}<none>${RESET}"
    ac=$(ago "$created" | sed 's/ ago//')
    days=$(( ( $(date +%s) - $(date -d "$created" +%s 2>/dev/null || date +%s) ) / 86400 ))
    if (( days > 180 )); then ac="${RED}${ac}${RESET}"; elif (( days > 60 )); then ac="${YELLOW}${ac}${RESET}"; fi
    uc="${GREY}unused${RESET}"; [[ -n "$used" ]] && uc="${GREEN}$(trunc "$used" 40)${RESET}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${BOLD}$(trunc "$tc" 50)${RESET}" "${GREY}${id}${RESET}" "$(human_bytes "$size")" "$ac" "$arch" "$uc"
  done
} | table
total=$(jq '[.[].Size] | add // 0' <<<"$images")
printf '\n  %sTotal:%s %s  %s(age: %s>60d%s %s>180d%s)%s\n' "$GREY" "$RESET" "$(human_bytes "$total")" \
  "$GREY" "$YELLOW" "$GREY" "$RED" "$GREY" "$RESET"

(( UPDATES )) || { echo; info "Run with ${BOLD}-u${RESET} to check for updates."; exit 0; }

# ── Update check ─────────────────────────────────────────────────────────
section "Update check"
remote_digest() {  # remote_digest REF → manifest-list/index digest for the tag
  local out
  if docker buildx version >/dev/null 2>&1; then
    out=$(timeout 30 docker buildx imagetools inspect "$1" --format '{{json .Manifest}}' 2>/dev/null) &&
      jq -r '.digest // empty' <<<"$out" && return 0
  fi
  out=$(timeout 30 docker manifest inspect -v "$1" 2>/dev/null) || return 1
  jq -r 'if type == "array" then empty else .Descriptor.digest // empty end' <<<"$out"
}

refs=$(jq -r --argjson u "$usage_map" --argjson all "$ALL" '
  .[] | select($all == 1 or ($u[.Id] != null)) | . as $i |
  (.RepoTags // [])[] | select(endswith(":<none>") | not) | [., ($i.RepoDigests // [] | join(" ") | if . == "" then "-" else . end), ($u[$i.Id] // [] | join(",") | if . == "" then "-" else . end)] | @tsv' <<<"$images" | sort -u)
[[ -z "$refs" ]] && { muted "  no tagged images to check"; exit 0; }

outdated=0 failed=0 rows=""
while IFS=$'\t' read -r ref digests used; do
  repo="${ref%:*}"
  [[ "$digests" == "-" ]] && digests=""
  [[ "$digests" == "-" ]] && digests=""
  local_d=$(tr ' ' '\n' <<<"$digests" | grep -F "${repo}@" | head -1 | sed 's/.*@//' || true)
  [[ -z "$local_d" ]] && local_d=$(tr ' ' '\n' <<<"$digests" | head -1 | sed 's/.*@//')
  printf '\r  %schecking %s…%s\e[K' "$GREY" "$ref" "$RESET" >&2
  if ! remote_d=$(remote_digest "$ref") || [[ -z "$remote_d" ]]; then
    st="${GREY}? unreachable${RESET}"; failed=$((failed+1)); remote_d="-"
  elif [[ -z "$local_d" ]]; then st="${GREY}? local build${RESET}"
  elif [[ "$local_d" == "$remote_d" ]]; then st="${GREEN}✔ up to date${RESET}"
  else st="${YELLOW}${BOLD}⬆ update${RESET}"; outdated=$((outdated+1)); fi
  rows+="${BOLD}${ref}${RESET}"$'\t'"$st"$'\t'"${GREY}${local_d:7:12}${RESET}"$'\t'"${GREY}${remote_d:7:12}${RESET}"$'\t'"$(trunc "${used:--}" 30)"$'\n'
done <<<"$refs"
printf '\r\e[K' >&2
{ printf 'IMAGE\tSTATUS\tLOCAL\tREMOTE\tUSED BY\n'; printf '%s' "$rows"; } | table
echo
if (( outdated > 0 )); then
  warn "${outdated} image(s) have updates. For compose stacks: ${BOLD}docker compose pull && docker compose up -d${RESET}"
else ok "All checked images are current."; fi
(( failed > 0 )) && muted "  ${failed} image(s) could not be checked (offline, rate-limited or private registry)."
echo
