# Copy to .env (git-ignored) or paste into Portainer → Stack → Environment variables.
# This password encrypts your restic repositories. If you lose it, you lose the backups.
RESTIC_PASSWORD=change-me

TZ=America/New_York

# Optional overrides
# BACKREST_REPOSITORY=/repos/optiplex/server
# STACKBACK_REPOSITORY=/mnt/restic-backups/optiplex/docker
# STACKBACK_CRON=0 2 * * *
