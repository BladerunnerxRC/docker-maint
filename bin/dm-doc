#!/usr/bin/env bash
# dm-doc — generate Markdown documentation of a Docker host's inventory.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
  cat <<EOF
${BOLD}dm-doc${RESET} — document containers, stacks, ports, volumes, networks and images as Markdown

${BOLD}Usage:${RESET} dm-doc [options]

${BOLD}Options:${RESET}
  -o, --output FILE    Write to FILE (default: docker-inventory-<host>-<date>.md)
      --stdout         Print Markdown to stdout instead of a file
  -e, --env            Include environment variables (secret-looking values are masked)
      --no-mask        With --env, do not mask secret values
  -h, --help           Show this help

${BOLD}Sections:${RESET} host summary · compose projects · containers · port map ·
volumes · bind mounts · networks · images
EOF
}

OUT="" STDOUT=0 ENV=0 MASK=1
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output) OUT="$2"; shift ;;
    --stdout)    STDOUT=1 ;;
    -e|--env)    ENV=1 ;;
    --no-mask)   MASK=0 ;;
    -h|--help)   usage; exit 0 ;;
    *) die "Unknown option: $1 (see --help)" ;;
  esac
  shift
done

need_docker; need jq
HOST=$(hostname)
[[ -z "$OUT" ]] && OUT="docker-inventory-${HOST}-$(date +%Y%m%d).md"

(( STDOUT )) || step "Collecting inventory from ${BOLD}${HOST}${RESET}…"

containers=$(docker ps -aq | xargs -r docker inspect)
[[ -n "$containers" ]] || containers='[]'
volumes=$(docker volume ls -q | xargs -r docker volume inspect)
[[ -n "$volumes" ]] || volumes='[]'
networks=$(docker network ls -q | xargs -r docker network inspect)
images=$(docker images -q | sort -u | xargs -r docker image inspect)
[[ -n "$images" ]] || images='[]'

# Markdown table escaping: pipes and newlines.
md_esc='def md: tostring | gsub("\\|"; "\\|") | gsub("\n"; " ");'

generate() {
  cat <<EOF
# Docker Inventory — \`${HOST}\`

> Generated by **dm-doc** on $(date '+%Y-%m-%d %H:%M %Z'). This file is a point-in-time snapshot.

## Host

| Property | Value |
|---|---|
EOF
  docker info --format '| Docker version | {{.ServerVersion}} |
| Operating system | {{.OperatingSystem}} |
| Kernel | {{.KernelVersion}} |
| Architecture | {{.Architecture}} |
| CPUs | {{.NCPU}} |
| Storage driver | {{.Driver}} |
| Docker root | `{{.DockerRootDir}}` |
| Swarm | {{.Swarm.LocalNodeState}} |'
  printf '| Memory | %s |\n' "$(human_bytes "$(docker info --format '{{.MemTotal}}')")"
  printf '| Compose | %s |\n' "$(docker compose version --short 2>/dev/null || echo 'n/a')"
  jq -r 'length as $t | map(select(.State.Running)) | length as $r |
         "| Containers | \($t) total, \($r) running |"' <<<"$containers"

  # ── Compose projects ──
  echo; echo "## Compose Projects"; echo
  jq -r "$md_esc"'
    map(select(.Config.Labels["com.docker.compose.project"])) |
    if length == 0 then "_No compose-managed containers._" else
    "| Project | Services | Running | Working dir | Compose file(s) |",
    "|---|---|---|---|---|",
    (group_by(.Config.Labels["com.docker.compose.project"])[] |
      .[0].Config.Labels as $l |
      "| **\($l["com.docker.compose.project"] | md)** | \(map(.Config.Labels["com.docker.compose.service"]) | unique | join(", ") | md) | \(map(select(.State.Running)) | length)/\(length) | `\($l["com.docker.compose.project.working_dir"] // "-" | md)` | `\($l["com.docker.compose.project.config_files"] // "-" | md)` |")
    end' <<<"$containers"

  # ── Containers ──
  echo; echo "## Containers"; echo
  jq -r "$md_esc"'
    if length == 0 then "_No containers._" else
    "| Name | Image | State | Health | Restart policy | Created | Networks |",
    "|---|---|---|---|---|---|---|",
    (sort_by(.Name)[] |
      "| **\(.Name | ltrimstr("/") | md)** | `\(.Config.Image | md)` | \(if .State.Running then "🟢 running" elif .State.Status == "exited" then "🔴 exited (\(.State.ExitCode))" else "🟡 \(.State.Status)" end) | \(.State.Health.Status // "—") | \(.HostConfig.RestartPolicy.Name // "no" | if . == "" then "no" else . end) | \(.Created[0:10]) | \(.NetworkSettings.Networks // {} | keys | join(", ") | md) |")
    end' <<<"$containers"

  # ── Port map ──
  echo; echo "## Published Ports"; echo
  jq -r "$md_esc"'
    [ .[] | (.Name | ltrimstr("/")) as $n |
      (.HostConfig.PortBindings // {}) | to_entries[] | .key as $k | (.value // [])[] |
      {host: ((if (.HostIp // "") == "" then "0.0.0.0" else .HostIp end) + ":" + .HostPort),
       port: (.HostPort | tonumber? // 0), container: $k, name: $n} ] |
    if length == 0 then "_No published ports._" else
    "| Host address | Container port | Container |", "|---|---|---|",
    (sort_by(.port)[] | "| `\(.host)` | `\(.container)` | \(.name | md) |")
    end' <<<"$containers"

  # ── Volumes ──
  echo; echo "## Volumes"; echo
  jq -r --argjson c "$containers" "$md_esc"'
    ([ $c[] | (.Name | ltrimstr("/")) as $n | .Mounts[]? | select(.Type == "volume") | {vol: .Name, use: "\($n):\(.Destination)"} ]
      | group_by(.vol) | map({key: .[0].vol, value: map(.use)}) | from_entries) as $used |
    if length == 0 then "_No volumes._" else
    "| Volume | Driver | Project | Mountpoint | Used by |", "|---|---|---|---|---|",
    (sort_by(.Name)[] |
      "| `\(.Name | if test("^[0-9a-f]{64}$") then .[0:12] + "… (anonymous)" else . end | md)` | \(.Driver) | \(.Labels["com.docker.compose.project"] // "—") | `\(.Mountpoint | md)` | \($used[.Name] // [] | if length == 0 then "⚠️ _unused_" else join("<br>") end | md) |")
    end' <<<"$volumes"

  # ── Bind mounts ──
  echo; echo "## Bind Mounts"; echo
  jq -r "$md_esc"'
    [ .[] | (.Name | ltrimstr("/")) as $n | .Mounts[]? | select(.Type == "bind") |
      {name: $n, src: .Source, dst: .Destination, mode: (if .RW then "rw" else "ro" end)} ] |
    if length == 0 then "_No bind mounts._" else
    "| Container | Host path | Container path | Mode |", "|---|---|---|---|",
    (sort_by(.name, .src)[] | "| \(.name | md) | `\(.src | md)` | `\(.dst | md)` | \(.mode) |")
    end' <<<"$containers"

  # ── Networks ──
  echo; echo "## Networks"; echo
  jq -r "$md_esc"'
    "| Network | Driver | Scope | Subnet | Gateway | Containers |", "|---|---|---|---|---|---|",
    (sort_by(.Name)[] |
      "| `\(.Name | md)` | \(.Driver) | \(.Scope) | \([.IPAM.Config[]?.Subnet] | join(", ") | if . == "" then "—" else "`\(.)`" end) | \([.IPAM.Config[]?.Gateway // empty] | join(", ") | if . == "" then "—" else . end) | \([.Containers // {} | .[].Name] | sort | join(", ") | if . == "" then "—" else . end | md) |")' <<<"$networks"

  # ── Images ──
  echo; echo "## Images"; echo
  jq -r --argjson c "$containers" "$md_esc"'
    ([ $c[].Image ] | unique) as $inuse |
    "| Repository:Tag | ID | Size | Created | In use |", "|---|---|---|---|---|",
    (sort_by(.RepoTags[0] // "~")[] |
      "| `\((.RepoTags // []) | if length == 0 then "<none>" else join("`<br>`") end | md)` | `\(.Id | ltrimstr("sha256:") | .[0:12])` | \((.Size / 1048576 * 10 | round / 10 | tostring) + " MB") | \(.Created[0:10]) | \(if (.Id as $i | $inuse | index($i)) then "✅" else "—" end) |")' <<<"$images"

  # ── Environment ──
  if (( ENV )); then
    echo; echo "## Environment Variables"; echo
    (( MASK )) && echo "_Values of variables whose names look secret are masked._" && echo
    jq -r --argjson mask "$MASK" "$md_esc"'
      sort_by(.Name)[] |
      "### \(.Name | ltrimstr("/"))", "",
      "| Variable | Value |", "|---|---|",
      (.Config.Env[]? | capture("^(?<k>[^=]*)=(?<v>.*)$") |
        "| `\(.k | md)` | `\(if $mask == 1 and (.k | test("PASS|SECRET|TOKEN|KEY|PRIVATE|CREDENTIAL|AUTH"; "i")) then "********" else .v end | md)` |"),
      ""' <<<"$containers"
  fi
}

if (( STDOUT )); then
  generate
else
  mkdir -p "$(dirname "$OUT")"
  generate > "$OUT"
  ok "Wrote ${BOLD}${OUT}${RESET} ${GREY}($(wc -l <"$OUT") lines, $(du -h "$OUT" | cut -f1))${RESET}"
  kv "Sections" "$(grep -c '^## ' "$OUT")"
  kv "Containers" "$(jq length <<<"$containers")"
  kv "Volumes" "$(jq length <<<"$volumes")"
  kv "Networks" "$(jq length <<<"$networks")"
  kv "Images" "$(jq length <<<"$images")"
fi
