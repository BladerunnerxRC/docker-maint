#!/usr/bin/env bash
# dm-compose-extract — reverse-engineer docker-compose.yml from running containers.
set -euo pipefail
LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=../lib/common.sh
source "$LIB/common.sh"

usage() {
  cat <<EOF
${BOLD}dm-compose-extract${RESET} — generate docker-compose YAML from existing containers

${BOLD}Usage:${RESET}
  dm-compose-extract [options] CONTAINER [CONTAINER...]
  dm-compose-extract [options] -p PROJECT
  dm-compose-extract [options] --all

${BOLD}Options:${RESET}
  -p, --project NAME   Extract every container of a compose project
  -a, --all            Extract all containers (running and stopped)
  -s, --split DIR      Write one compose file per project into DIR/<project>/compose.yaml
                       (containers without a project go to DIR/<container>/compose.yaml)
  -o, --output FILE    Write to FILE instead of stdout
  -r, --redact         Replace secret-looking env values (PASSWORD, TOKEN, KEY…) with \${VAR}
  -m, --managed-networks
                       Let compose create the networks (same name) instead of marking them
                       external — use when the original project will be taken down
      --no-validate    Skip 'docker compose config' validation of the result
  -h, --help           Show this help

${BOLD}Notes:${RESET}
  • Only settings that differ from the image defaults are emitted.
  • Named volumes and custom networks are marked ${ITALIC}external${RESET} so existing data is reused.
  • Always review the output — runtime-only details (e.g. secrets in env) are included verbatim
    unless --redact is used.

${BOLD}Examples:${RESET}
  dm-compose-extract nginx > compose.yaml
  dm-compose-extract -p grafana -r -o grafana/compose.yaml
  dm-compose-extract --all --split ./extracted
EOF
}

PROJECT="" ALL=0 OUT="" SPLIT="" REDACT=false MANAGED=false VALIDATE=1 NAMES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--project)  PROJECT="$2"; shift ;;
    -a|--all)      ALL=1 ;;
    -s|--split)    SPLIT="$2"; shift ;;
    -o|--output)   OUT="$2"; shift ;;
    -r|--redact)   REDACT=true ;;
    -m|--managed-networks) MANAGED=true ;;
    --no-validate) VALIDATE=0 ;;
    -h|--help)     usage; exit 0 ;;
    -*) die "Unknown option: $1 (see --help)" ;;
    *)  NAMES+=("$1") ;;
  esac
  shift
done

need_docker; need jq
[[ -n "$OUT" && -n "$SPLIT" ]] && die "--output and --split are mutually exclusive"

# ── Resolve target containers ────────────────────────────────────────────
if [[ -n "$PROJECT" ]]; then
  mapfile -t NAMES < <(docker ps -a --filter "label=com.docker.compose.project=$PROJECT" --format '{{.Names}}')
  (( ${#NAMES[@]} )) || die "No containers found for project '$PROJECT'"
elif (( ALL )); then
  mapfile -t NAMES < <(docker ps -a --format '{{.Names}}')
fi
(( ${#NAMES[@]} )) || { usage >&2; exit 1; }

inspect=$(docker inspect "${NAMES[@]}" 2>/dev/null) || die "Could not inspect: ${NAMES[*]}"

# Image defaults, keyed by image ID, so we only emit what was overridden.
images_json=$(jq -r '[.[].Image] | unique[]' <<<"$inspect" |
  xargs -r docker image inspect 2>/dev/null |
  jq 'map({key: .Id, value: .Config}) | from_entries') || images_json='{}'
[[ -n "$images_json" ]] || images_json='{}'

render() {   # render <inspect-json-array>  → YAML on stdout
  local header
  header="# Generated by dm-compose-extract on $(date '+%Y-%m-%d %H:%M') from host $(hostname)
# Containers: $(jq -r 'map(.Name | ltrimstr("/")) | join(", ")' <<<"$1")
# Review before use: values are captured from the live runtime configuration."
  jq -r --argjson images "$images_json" --argjson redact "$REDACT" --argjson managed "$MANAGED" --arg header "$header" \
    -f "$LIB/compose-extract.jq" <<<"$1"
}

validate() { # validate <file>
  (( VALIDATE )) || return 0
  local cc
  cc=$(compose_cmd) || { warn "docker compose not available; skipping validation"; return 0; }
  local msg
  if msg=$($cc -f "$1" config -q 2>&1); then ok "Valid compose file: ${BOLD}$1${RESET}"
  else warn "Validation reported problems for $1:"; sed "s/^/    ${GREY}│${RESET} /" <<<"$msg" >&2; fi
}

summary() { # summary <inspect-json> <dest>
  jq -r '.[] | [(.Name|ltrimstr("/")), .Config.Image] | @tsv' <<<"$1" |
    while IFS=$'\t' read -r n i _; do
      printf '    %s•%s %s%s%s %s(%s)%s → %s\n' "$CYAN" "$RESET" "$BOLD" "$n" "$RESET" "$GREY" "$i" "$RESET" "$2"
    done
}

# ── Split mode: one file per project ─────────────────────────────────────
if [[ -n "$SPLIT" ]]; then
  mkdir -p "$SPLIT"
  step "Extracting ${#NAMES[@]} container(s) into ${BOLD}$SPLIT${RESET}"
  while IFS= read -r group; do
    dir="$SPLIT/$(jq -r '.[0] | (.Config.Labels["com.docker.compose.project"] // (.Name|ltrimstr("/")))' <<<"$group")"
    mkdir -p "$dir"
    render "$group" > "$dir/compose.yaml"
    summary "$group" "$dir/compose.yaml"
    validate "$dir/compose.yaml"
  done < <(jq -c 'group_by(.Config.Labels["com.docker.compose.project"] // (.Name|ltrimstr("/")))[]' <<<"$inspect")
  ok "Done."
  exit 0
fi

# ── Single file ───────────────────────────────────────────────────────────
if [[ -n "$OUT" ]]; then
  mkdir -p "$(dirname "$OUT")"
  render "$inspect" > "$OUT"
  step "Extracted ${#NAMES[@]} container(s):"
  summary "$inspect" "$OUT"
  validate "$OUT"
else
  yaml=$(render "$inspect")
  if [[ -n "$RESET" ]]; then
    # Light YAML syntax highlighting for terminal viewing.
    sed -E \
      -e "s/^(#.*)$/${GREY}\1${RESET}/" \
      -e "s/^([a-z_]+):/${MAGENTA}${BOLD}\1${RESET}:/" \
      -e "s/^(  [A-Za-z0-9_.\"-]+):$/${CYAN}${BOLD}\1${RESET}:/" \
      -e "s/^( {4,}[a-z_]+):/${BLUE}\1${RESET}:/" \
      -e "s/(\"[^\"]*\")/${GREEN}\1${RESET}/g" <<<"$yaml"
  else
    printf '%s\n' "$yaml"
  fi
  if (( VALIDATE )) && cc=$(compose_cmd); then
    tmp=$(mktemp --suffix=.yaml); trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$yaml" > "$tmp"
    $cc -f "$tmp" config -q >/dev/null 2>&1 || warn "Generated YAML did not pass 'compose config' — review it before use."
  fi
fi
